{
  "name": "livesuite",
  "version": "1.0.0",
  "main": "tscdist/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.livesuite.app",
    "files": [
      "tscdist/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "./subbuild/",
        "to": "subbuild",
        "filter": ["*.exe"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "differentialPackage": false,
      "packElevateHelper": false
    }
  },
  "devDependencies": {
    "@types/node-media-server": "^2.3.7",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-media-server": "^4.2.4"
  }
}