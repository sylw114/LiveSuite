{
  "name": "livesuite",
  "productName": "LiveSuite",
  "version": "1.1.0",
  "main": "tscdist/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "build:native": "call udp\\build.bat",
    "build:stream-server": "tsc -p stream-server/tsconfig.json",
    "build:quic:compile": "cargo build --manifest-path native/livesuite-quic/Cargo.toml --release",
    "build:quic": "npm run build:quic:compile && node scripts/copy-quic-binary.js",
    "build:all": "npm run build:native && npm run build:stream-server && npm run build:quic && npm run build",
    "test:quic-timestamp": "npm run build && node scripts/test-quic-timestamp.js",
    "build:package": "npm run build:native && npm run build:stream-server && npm run build:quic && npm run build",
    "predist": "npm run build:package && npm run licenses",
    "dist": "electron-builder",
    "release": "npm run dist",
    "licenses": "node scripts/generate-licenses.js",
    "licenses:check": "license-checker --production --json > licenses/licenses.json",
    "licenses:csv": "license-checker --production --csv > licenses/licenses.csv",
    "licenses:text": "license-checker --production --outFile licenses/THIRD_PARTY_LICENSES.txt"
  },
  "build": {
    "files": [
      "tscdist/**/*",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "./subbuild/",
        "to": "subbuild",
        "filter": [
          "audio_server_udp.exe",
          "livesuite_audio_quic.dll",
          "*.md"
        ]
      },
      {
        "from": "./native-bin/",
        "to": "subbuild",
        "filter": [
          "livesuite-quic-server.node"
        ]
      },
      {
        "from": "./native/livesuite-quic/src/",
        "to": "subbuild",
        "filter": [
          "browser_player.html"
        ]
      },
      {
        "from": "./licenses/",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiveSuite",
      "uninstallDisplayName": "LiveSuite ${version}",
      "runAfterFinish": true,
      "license": "LICENSE",
      "differentialPackage": false,
      "packElevateHelper": true
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@livesuite/stream-server": "file:stream-server"
  }
}
